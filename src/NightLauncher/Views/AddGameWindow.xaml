<Window x:Class="NightLauncher.Views.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game details"
        Width="650"
        Height="570"
        MinWidth="560"
        MinHeight="530"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0B1020"
        Foreground="#E2E8F0">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock x:Name="HeadingText" Text="Add a game" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="Choose an executable or send the game to the official Steam client. Steam and publisher ownership checks remain enabled."
                       Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,7,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Display name" Foreground="#CBD5E1" Margin="0,0,0,7"/>
            <TextBox x:Name="NameTextBox" Margin="0,0,0,15" MaxLength="120"/>

            <TextBlock Text="Launch method" Foreground="#CBD5E1" Margin="0,0,0,7"/>
            <ComboBox x:Name="LaunchModeCombo" Margin="0,0,0,15" SelectionChanged="LaunchMode_SelectionChanged">
                <ComboBoxItem Content="Direct executable" Tag="Executable"/>
                <ComboBoxItem Content="Official Steam client" Tag="Steam"/>
            </ComboBox>

            <StackPanel x:Name="ExecutablePanel">
                <TextBlock Text="Game executable (.exe)" Foreground="#CBD5E1" Margin="0,0,0,7"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExecutableTextBox" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="Browse…" Click="Browse_Click" VerticalAlignment="Top"/>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="SteamPanel" Visibility="Collapsed">
                <TextBlock Text="Steam App ID" Foreground="#CBD5E1" Margin="0,0,0,7"/>
                <TextBox x:Name="SteamAppIdTextBox" Margin="0,0,0,15" MaxLength="10"
                         ToolTip="Numeric App ID. Steam performs the normal ownership and authentication checks."/>
                <TextBlock Text="Example: GTA V Legacy uses Steam App ID 271590. This only asks Steam to launch the game; it does not grant ownership."
                           Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15"/>
            </StackPanel>

            <StackPanel x:Name="ArgumentsPanel">
                <TextBlock Text="Launch arguments (optional)" Foreground="#CBD5E1" Margin="0,0,0,7"/>
                <TextBox x:Name="ArgumentsTextBox" Height="70"
                         VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4096"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="NightLauncher does not bypass DRM or sign-in requirements."
                       Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="Cancel" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Grid.Column="2" Content="Save game" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
