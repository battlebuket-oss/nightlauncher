<Window x:Class="NightLauncher.Views.DiscoveredGamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discovered games"
        Width="820"
        Height="620"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#0B1020"
        Foreground="#E2E8F0">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Review discovered executables" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="CandidateCountText" Text="Select the game executables to add."
                       Foreground="#94A3B8" Margin="0,7,0,0"/>
            <TextBlock Text="Discovery only lists files. Nothing is added or launched until you select it. Avoid adding installers, tools, or executables you do not trust."
                       Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#111A2B" CornerRadius="12" Padding="12">
            <ListBox x:Name="CandidatesListBox" SelectionMode="Extended">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#172338" CornerRadius="8" Padding="11" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding ExecutablePath}" Foreground="#94A3B8"
                                           FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tip: use Ctrl or Shift to select multiple entries."
                       Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="Cancel" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Grid.Column="2" Content="Add selected" Style="{StaticResource PrimaryButtonStyle}"
                    Click="AddSelected_Click"/>
        </Grid>
    </Grid>
</Window>
