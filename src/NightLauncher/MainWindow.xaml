<Window x:Class="NightLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightLauncher"
        Width="1240"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020"
        Foreground="#E2E8F0">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111A2B" CornerRadius="16" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="0,2,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#7C3AED">
                            <TextBlock Text="N" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="NIGHTLAUNCHER" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="YOUR LOCAL GAME HUB" Foreground="#64748B" FontSize="9" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="WORKSPACE" Foreground="#64748B" FontWeight="Bold" FontSize="10" Margin="2,0,0,10"/>
                    <Border Background="#202B43" CornerRadius="9" Padding="11,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" Foreground="#C4B5FD" FontSize="16" Margin="0,0,11,0"/>
                            <TextBlock Text="Game library" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="TOOLS" Foreground="#64748B" FontWeight="Bold" FontSize="10" Margin="2,26,0,10"/>
                    <Button Content="＋   Add a game" HorizontalContentAlignment="Left" Style="{StaticResource QuietButtonStyle}" Click="AddGame_Click"/>
                    <Button Content="⇧   Import library" HorizontalContentAlignment="Left" Style="{StaticResource QuietButtonStyle}" Click="Import_Click"/>
                    <Button Content="⇩   Export library" HorizontalContentAlignment="Left" Style="{StaticResource QuietButtonStyle}" Click="Export_Click"/>
                    <Button x:Name="FindGamesButton" Content="⌕   Find games in folder" HorizontalContentAlignment="Left" Style="{StaticResource QuietButtonStyle}" Click="DiscoverGames_Click"/>
                    <Button x:Name="ScanSteamButton" Content="▣   Find installed Steam games" HorizontalContentAlignment="Left" Style="{StaticResource QuietButtonStyle}" ToolTip="Read local Steam library metadata and add installed games" Click="DiscoverSteamGames_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#0E1728" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="LOCAL &amp; PRIVATE" Foreground="#A78BFA" FontWeight="Bold" FontSize="10"/>
                            <TextBlock Text="Your library stays on this PC. No account or cloud sync is required."
                                       Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button Content="⚙   Settings &amp; privacy" HorizontalContentAlignment="Left" Style="{StaticResource QuietButtonStyle}" Click="Settings_Click"/>
                    <TextBlock Text="NIGHTLAUNCHER  ·  1.3.0" Foreground="#475569" FontSize="9" Margin="4,14,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24,4,4,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Your collection" FontSize="29" FontWeight="Bold"/>
                    <TextBlock Text="Keep your installed PC games organized in one place."
                               Foreground="#94A3B8" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="＋  Add game" Style="{StaticResource PrimaryButtonStyle}"
                        VerticalAlignment="Center" Padding="18,12" Click="AddGame_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,24,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="325"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#111A2B" CornerRadius="14" Padding="18" Margin="0,0,18,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LIBRARY" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CountText" Grid.Column="1" Text="0 games" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,0,0,15"
                                 ToolTip="Search your library" TextChanged="SearchBox_TextChanged"/>
                        <Grid Grid.Row="2">
                            <ListBox x:Name="GamesList" SelectionChanged="GamesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#172338" CornerRadius="10" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" Background="#293858" CornerRadius="9" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Initials}" Foreground="#DDD6FE" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Category}" Foreground="#A78BFA" FontSize="10" Margin="0,4,0,2"/>
                                                    <TextBlock Text="{Binding LaunchTargetDescription}" Foreground="#64748B" FontSize="10"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MaxWidth="280" IsHitTestVisible="False">
                                <TextBlock Text="▣" FontSize="34" Foreground="#475569" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="EmptyTitle" Text="Your library is empty" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,12,0,5"/>
                                <TextBlock x:Name="EmptyMessage" Text="Add a game by selecting its executable file."
                                           Foreground="#64748B" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="#111A2B" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <TextBlock Text="GAME DETAILS" Foreground="#A78BFA" FontWeight="Bold" FontSize="11"/>
                        <Border Width="66" Height="66" Background="#293858" CornerRadius="15" Margin="0,24,0,15"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="DetailInitials" Text="—" FontSize="25" FontWeight="Bold"
                                       Foreground="#DDD6FE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="DetailName" Text="Select a game" FontSize="21" FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailCategory" Text="No game selected" Foreground="#A78BFA" FontSize="11" Margin="0,6,0,18"/>
                        <TextBlock Text="LAUNCH TARGET" Foreground="#64748B" FontSize="9" FontWeight="Bold"/>
                        <TextBlock x:Name="DetailPath" Text="Choose a game from your library to see its launch target."
                                   Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,15"/>
                        <StackPanel x:Name="InstallLocationPanel" Visibility="Collapsed" Margin="0,0,0,16">
                            <TextBlock Text="INSTALL LOCATION" Foreground="#64748B" FontSize="9" FontWeight="Bold"/>
                            <TextBlock x:Name="DetailInstallDirectory" Foreground="#94A3B8" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,6,0,8"/>
                            <Button x:Name="OpenInstallFolderButton" Content="Open install folder"
                                    Style="{StaticResource QuietButtonStyle}" IsEnabled="False"
                                    Click="OpenInstallFolder_Click"/>
                        </StackPanel>
                        <TextBlock Text="LAST LAUNCHED" Foreground="#64748B" FontSize="9" FontWeight="Bold"/>
                        <TextBlock x:Name="DetailLastLaunched" Text="Not launched yet" Foreground="#94A3B8" FontSize="11" Margin="0,6,0,22"/>

                        <Button x:Name="LaunchButton" Content="▶   Launch game" Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="False" Click="Launch_Click" Padding="12,13"/>
                        <Button x:Name="EditButton" Content="Edit details" Margin="0,9,0,0" IsEnabled="False"
                                Click="Edit_Click"/>
                        <Button x:Name="RemoveButton" Content="Remove from library" Style="{StaticResource QuietButtonStyle}"
                                IsEnabled="False" Margin="0,4,0,0" Click="Remove_Click"/>
                        <TextBlock Text="Steam launches are handed to the official Steam client, which retains its normal ownership and authentication checks."
                                   Foreground="#64748B" FontSize="10" TextWrapping="Wrap" Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="LOCAL LIBRARY  ·  NO ACCOUNT REQUIRED"
                           Foreground="#475569" FontSize="9" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
